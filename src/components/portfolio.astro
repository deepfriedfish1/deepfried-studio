---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const portfolioItems = await getCollection('portfolio') as CollectionEntry<'portfolio'>[];
---

<section id="portfolio">
  <div class="container">
    <div class="section-title">
      <h2>Наши работы</h2>
      <p>Ознакомьтесь с нашими последними проектами в различных областях</p>
    </div>
    <div class="portfolio-filter">
      <button class="filter-btn active" data-filter="all">Все работы</button>
      <button class="filter-btn" data-filter="web">Веб-сайты</button>
      <button class="filter-btn" data-filter="shop">Интернет-магазины</button>
      <button class="filter-btn" data-filter="app">Веб-приложения</button>
    </div>
    <div class="portfolio-grid" id="portfolioGrid">
      {
        portfolioItems.map((item) => (
          <div class={`portfolio-item ${item.data.category}`}>
            <img src={item.data.image} alt={item.data.title} />
            <div class="portfolio-overlay">
              <h3>{item.data.title}</h3>
              <p>{item.data.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>