---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// Явно указываем тип для переменной, которая получит результат getCollection
const services = await getCollection('services') as CollectionEntry<'services'>[];
---

<section id="services">
  <div class="container">
    <div class="section-title">
      <h2>Наши услуги</h2>
      <p>Мы предлагаем полный спектр услуг для создания и продвижения вашего онлайн-присутствия</p>
    </div>
    <div class="services-grid">
      {
        // Теперь service имеет правильный тип CollectionEntry<'services'>
        services.map((service) => (
          <div class="service-card">
            <div class="service-icon">
              <i class={service.data.icon}></i>
            </div>
            <h3>{service.data.title}</h3>
            <p>{service.data.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>